; Engine configuration file.
config_version=5

[application]
config/name="Грязная работа"
config/description="Хоррор от первого лица про уборщика"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
Game="*res://autoload/game.gd"
Audio="*res://autoload/audio_bus.gd"
Director="*res://autoload/director.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/msaa_3d=0
scaling_3d/scale=1.0
limits/opengl/max_renderable_lights=64
limits/opengl/max_lights_per_object=8
lights_and_shadows/directional_shadow/size=1024

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="interact"
3d_physics/layer_3="dirt"
3d_physics/layer_4="props"
3d_physics/layer_5="player"
3d_physics/layer_6="monster"
