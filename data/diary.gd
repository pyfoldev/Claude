class_name Diary extends RefCounted
## Дневник героя — мысли, которые накапливаются по главам.

const ENTRIES := {
	1: "Лесная, 12. Заказчик не звонит, только СМС. Платят по факту. Алиса просила торт на день рождения — осталось всего ничего до зарплаты.\nДом тихий. Слишком чистая тишина.",
	2: "Коммуналка на Садовой. Записки от троих, а слова одни и те же. Вещи здесь дышат. Фонарь — мой друг.",
	3: "Вороновы. В зеркале стоял кто-то за моей спиной. Радио назвало меня по имени. Я не говорил им имени.\nНа стене детской — рисунок. Подпись «Алиса». Откуда?",
	4: "Мы вернулись на Лесную. Бейдж Артёма Ситникова. Дневник. «Каждая СМС — это я».\nЗаказчик — не человек. Дом. Хозяин ходит по этажам.",
	5: "Тихая, 1. Договор на 41 подпись. Дом кормится нами. Я вошёл в портал — и вот что значит «ТЫ НАШ».",
	6: "Изнанка. Все дома — один. Артём жив — в стене. Печати трёх семей. Нужен Коридор.",
	7: "Коридор домов. Дом говорит голосом Алисы. Мать Громовых: «Сердце можно только вымыть».",
	8: "Сердце Дома. Один заказ остался. Самый чистый.",
}

static func text_for(chapter: int, truth: int) -> String:
	var t := ""
	for c in range(1, chapter + 1):
		t += "[b]Глава %d.[/b]\n%s\n\n" % [c, ENTRIES.get(c, "")]
	t += "[i]Найдено настоящих записок: %d из %d.[/i]" % [NotesDB.true_found(), NotesDB.true_ids().size()]
	return t
