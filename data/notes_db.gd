static func true_ids() -> Array:
	var out := []
	for k in NOTES:
		if NOTES[k].kind == "true":
			out.append(k)
	return out

static func true_found() -> int:
	var n := 0
	for k in true_ids():
		if Game.notes_found.has(k):
			n += 1
	return n
