# ---------- обязательное ----------
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль
# openssl rand -base64 48
STAIKA_JWT_SECRET=
# openssl rand -base64 48   (после смены все пользователи выйдут)
# ВАЖНО: при потере этого ключа сохранённые ключи провайдеров не расшифровать
STAIKA_MASTER_KEY=
# ваш домен для HTTPS; для проверки по IP оставьте :80
STAIKA_DOMAIN=:80

# ---------- владелец и регистрация ----------
# аккаунт с этой почтой получит роль owner (первый зарегистрированный тоже станет owner)
STAIKA_OWNER_EMAIL=you@example.com
STAIKA_REGISTRATION_OPEN=true

# ---------- письма (коды входа, сброс пароля): Brevo ----------
BREVO_API_KEY=
STAIKA_MAIL_FROM=no-reply@your-domain.com
STAIKA_MAIL_FROM_NAME=Стайка

# ---------- модели: серверные ключи (доступны ролям owner и family) ----------
ANTHROPIC_API_KEY=
RIVER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------- голос ----------
DEEPGRAM_API_KEY=
# голос агента (Vladimir): точный ID модели см. в документации Deepgram, формат:
# {"provider":{"type":"deepgram","model":"<id голоса>"}}
STAIKA_VOICE_SPEAK_JSON=

# ---------- вход через Google (Web client ID из Google Cloud Console, несколько через запятую) ----------
STAIKA_GOOGLE_CLIENT_IDS=

# ---------- песочница для shell (оставьте пустым, пока не нужна) ----------
STAIKA_SANDBOX_IMAGE=
