BOT_TOKEN=123456:replace-me
WEBAPP_URL=https://bot.example.com
# ваш Telegram id (узнать у @userinfobot); можно несколько через запятую: 123,456
OWNER_ID=0
WEBHOOK_SECRET=change-me-long-random
# куда Telegram шлёт обновления в режиме webhook: https://домен:88 (порты 443, 80, 88, 8443); по умолчанию — WEBAPP_URL
WEBHOOK_URL=
DB_PATH=data/bot.db
# webhook | polling
MODE=polling
# сколько обновлений Telegram обрабатывается одновременно в режиме webhook (по умолчанию 64)
# UPDATE_WORKERS=64
# порт встроенного веб-сервера (капча + webhook)
PORT=8080

# --- ИИ и расшифровка (необязательно: без ключей эти функции выключены) ---
RIVER_API_KEY=
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# модель для второго мнения по сомнительным картинкам (по умолчанию Nemotron VL); работает, только если в чате включено «ИИ-проверка сомнительных»
# RIVER_VISION_MODEL=
MISTRAL_API_KEY=
MISTRAL_STT_MODEL=voxtral-mini-latest
# URL своего GigaAM, например http://172.18.0.1:8792; пусто — расшифровка выключена
GIGAAM_URL=

# --- генерация картинок: Cloudflare Workers AI (бесплатно в рамках суточного лимита Workers AI) ---
# dash.cloudflare.com → Workers AI → «Use REST API»: Account ID и API-токен с правом Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- скачивание из соцсетей (yt-dlp) ---
# необязательно: путь к cookies.txt (формат Netscape) для Instagram/YouTube, которые часто требуют вход.
# Лучше завести отдельный аккаунт, а не свой основной. Файл положить в ./data (он смонтирован в контейнер как /data).
# YTDLP_COOKIES=/data/cookies.txt

# --- Nori Premium (подписка за звёзды Telegram, 30 дней, автопродление) ---
PREMIUM_PRICE=70
# модели ИИ на выбор для Premium через запятую; пусто — бот сам берёт список у River (GET /models)
# AI_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,Qwen/Qwen3-235B-A22B

# IP доверенных reverse proxy через запятую; только от них панель принимает X-Forwarded-For.
# TRUSTED_PROXY_IPS=127.0.0.1
# Для профиля pg задайте собственный пароль: PostgreSQL не запустится с пустым.
# POSTGRES_PASSWORD=
