<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center" android:orientation="horizontal" android:padding="8dp">
    <ImageView android:id="@+id/w_chat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:src="@drawable/ic_sc_chat" android:contentDescription="@string/sc_chat" />
    <ImageView android:id="@+id/w_voice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:src="@drawable/ic_sc_voice" android:contentDescription="@string/sc_voice" />
    <ImageView android:id="@+id/w_camera" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:src="@drawable/ic_sc_camera" android:contentDescription="@string/sc_camera" />
</LinearLayout>
