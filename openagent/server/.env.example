# ---- Сервер ----
PORT=8787
PUBLIC_URL=https://openagents.duckdns.org
DATA_DIR=/srv/openagent/data
WORKSPACES_DIR=/srv/openagent/workspaces
JWT_SECRET=change-me-long-random-string
# Кто может войти и получает shell на сервере (через запятую)
OWNER_EMAILS=you@example.com
# Другие разрешённые e-mail (без shell). Или OPEN_REGISTRATION=true для всех
ALLOWED_EMAILS=
OPEN_REGISTRATION=false

# ---- ИИ (river.ai, OpenAI-совместимый API) ----
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_API_KEY=
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
RIVER_FAST_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
RIVER_VISION_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
RIVER_VISION=false

# ---- Речь ----
# MISTRAL_API_KEY нужен только для эмбеддингов памяти (mistral-embed)
MISTRAL_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_STREAM_MODEL=nova-3
# Озвучка: deepgram (по умолчанию; при сбое автоматически Fish) или fish. Aura-2 — без русского; Flux TTS (flux-vladimir-ru) требует доступа проекта Deepgram
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_VOICE=flux-vladimir-ru
DEEPGRAM_TTS_EXPRESSIVITY=0
EMBED_MODEL=mistral-embed
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=s2.1-pro-free

# ---- Почта (Brevo SMTP) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ---- Cloudflare Turnstile ----
TURNSTILE_SITE_KEY=0x4AAAAAAGHH8dhL4wA2JrdS
TURNSTILE_SECRET=

# ---- Google вход (Web client ID из Firebase) ----
GOOGLE_CLIENT_IDS=199268040211-o81u4shtd4trbemiorddnjs3jm7acd9g.apps.googleusercontent.com

# ---- GitHub OAuth App (включить Device Flow) ----
GITHUB_CLIENT_ID=

# Coarena (бесплатный ключ на coarena.ai/api). Если указан — провайдер Coarena доступен всем без ввода ключа в приложении
COARENA_API_KEY=
# Groq (gpt-oss-120b) работает ЧЕРЕЗ ТЕЛЕФОН: ключ вводится в приложении (Настройки → Groq), сервер к Groq не обращается.
# GROQ_API_KEY= — нужен только если сервер сам может достучаться до Groq (по умолчанию не нужен)
# UnoRouter — бесплатные модели (:free) и генерация картинок: ключ на unorouter.com (для части моделей один раз дать согласие на сайте)
UNOROUTER_API_KEY=
COARENA_MODELS=gpt-6-luna,gemini-3-8-flash,deepseek-v4-1-flash-1017

# Exa — нейро-веб-поиск (ключ: https://dashboard.exa.ai/api-keys). Если указан, web_search использует Exa, иначе запасной поиск
EXA_API_KEY=

# --- Режима «Авто» больше нет: по умолчанию DeepSeek (river.ai). Ниже — необязательные ключи провайдеров ---
# Бесплатный ключ: coarena.ai/api (30 запросов/мин). Без ключа «Авто» работает только на river.ai (DeepSeek/GLM).
COARENA_API_KEY=
# Кандидаты по порядку (формат provider:model, provider = river | coarena). Недоступные пропускаются.
# AUTO_CODE=river:deepseek-ai/DeepSeek-V4.1-Flash,river:zai-org/GLM-5.3-Flash
# AUTO_SCHOOL=coarena:gpt-6-luna,coarena:gemini-3-8-flash,coarena:deepseek-v4-1-flash-1017
# AUTO_HUMANITIES=coarena:gemini-3-8-flash,coarena:gpt-6-luna
# AUTO_GENERAL=groq:openai/gpt-oss-120b,coarena:gemini-3-8-flash,coarena:gpt-6-luna

# IMAGE_MODELS=flux-2-dev:free,flux-2-klein-9b:free,flux.1-schnell:free,phoenix-1.0:free

# --- Perplexity (необязательно): по умолчанию ключ вводится в приложении (Настройки → Поиск и Perplexity), запросы идут через телефон ---
# PERPLEXITY_API_KEY=

# --- Голосовой режим: Deepgram Voice Agent (STT nova-3 + Claude Haiku 4.5 + голос «Владимир» Flux TTS) — работает на ключе DEEPGRAM_API_KEY, отдельный ключ Anthropic не нужен ---
# VOICE_AGENT=0                          # выключить (вернётся прежний режим: STT → модель → TTS)
# VOICE_THINK_MODEL=claude-haiku-4-5
# VOICE_SPEAK_MODEL=flux-vladimir-ru
# VOICE_LISTEN_MODEL=nova-3


# --- Движки ---
# RIVER_CODE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash   # модель режима Code (opencode); можно взять сильнее из /models river.ai
# CODE_ENGINE=legacy      # вернуть встроенный цикл вместо opencode
# CHAT_ENGINE=legacy      # вернуть встроенный цикл чата вместо AI SDK
# OPENDESIGN_DIR=/opt/opendesign

# --- Локальная модель на сервере (deploy/setup-local-llm.sh): Qwen3.5-2B ТОЛЬКО для болтовни (короткий промпт, без инструментов); всё остальное — облако ---
# LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=qwen3.5-2b
# LOCAL_LLM=0             # выключить маршрутизацию на локальную модель

# --- Дополнительные провайдеры (ключ → модели появляются в приложении у всех; без ключа их можно добавить в приложении: Модель → Свой) ---
# KIE_API_KEY=            # kie.ai: Claude, GPT-6.x, Grok, Gemini, DeepSeek, Kimi (адаптер server/src/kie.js; KIE_MODELS= — свой список)
# PUTER_AUTH_TOKEN=       # Puter: GPT, Claude, Gemini и др. (puter.com → Dashboard → API token)
# DAHL_API_KEY=           # Dahl Inference (inference.dahl.global)
# COHERE_API_KEY=         # Cohere (OpenAI-совместимый слой)
# VYCE_API_KEY=           # Vyce AI (vyceai.com)
